# ============================================================================
# Environnement Docker de dev pour sites Lutece 7 (Tomcat 9/JDK17 + MariaDB)
# Copiez ce fichier en `.env` et ajustez, puis `docker compose up -d --build`.
# ============================================================================

# --- Versions des images ---
# Tomcat 9 (servlet javax, requis par Lutece 7) sur JDK 17 (libs grubusiness/
# library-notifygru compilées en Java 17 -> JDK 11 donne UnsupportedClassVersionError).
TOMCAT_IMAGE=tomcat:9.0-jdk17-temurin
MARIADB_IMAGE=mariadb:10.11

# --- Ports exposés sur la machine hôte ---
TOMCAT_HTTP_PORT=8080
TOMCAT_DEBUG_PORT=8000
DB_PORT=3307

# --- Base de données ---
# NB: la base est créée automatiquement (vide) si db-init/ ne contient pas de dump.
# Si votre dump crée/sélectionne une base précise, alignez DB_NAME dessus.
DB_NAME=lutece
DB_USER=lutece
DB_PASSWORD=lutece
DB_ROOT_PASSWORD=root

# Timezone utilisée par Tomcat et la connexion JDBC
TZ=Europe/Paris

# --- Déploiement ---
# Nom de la webapp = contexte Tomcat (URL http://localhost:PORT/<WEBAPP_NAME>/...).
# Utilisé par bin/deploy-site.sh (surchargeable en 3e argument du script).
WEBAPP_NAME=lutece
