<?xml version="1.0" encoding="UTF-8"?>
<!-- ==========================================================================
     Contexte Tomcat par défaut, appliqué à TOUTES les webapps déployées.
     Fournit la datasource JNDI jdbc/CORE attendue par Lutece 7 (profil dev,
     fr.paris.lutece.util.pool.service.TomcatConnectionService + portal.ds=jdbc/CORE).

     Les valeurs ${db.*} sont injectées par Tomcat depuis les propriétés système
     passées via JAVA_OPTS (voir docker-compose.yml -> issues du .env).
     ========================================================================== -->
<Context>

    <!-- Empêche le rechargement automatique en cas de modif des .class montés -->
    <WatchedResource>WEB-INF/web.xml</WatchedResource>
    <WatchedResource>${catalina.base}/conf/web.xml</WatchedResource>

    <Resource
        name="jdbc/CORE"
        auth="Container"
        type="javax.sql.DataSource"
        factory="org.apache.tomcat.jdbc.pool.DataSourceFactory"
        driverClassName="com.mysql.cj.jdbc.Driver"
        url="${db.url}"
        username="${db.user}"
        password="${db.password}"
        initialSize="2"
        maxTotal="50"
        maxIdle="10"
        minIdle="2"
        maxWaitMillis="10000"
        validationQuery="SELECT 1"
        testOnBorrow="true"
        removeAbandonedOnBorrow="true"
        removeAbandonedTimeout="300"
        defaultAutoCommit="true" />

</Context>
